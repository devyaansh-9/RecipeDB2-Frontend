    "/recipe2-api/connections/links": {
      "get": {
        "tags": [
          "Cross-Database Connections"
        ],
        "summary": "Get RecipeDB and FlavorDB Links",
        "description": "Returns joined records mapping RecipeDB ingredients to FlavorDB entities.",
        "parameters": [
          {
            "name": "ingredient",
            "in": "query",
            "description": "RecipeDB ingredient text (example: salt)",
            "required": false,
            "type": "string"
          },
          {
            "name": "entity_id",
            "in": "query",
            "description": "FlavorDB entity ID (example: 778)",
            "required": false,
            "type": "integer"
          },
          {
            "name": "entity_alias_readable",
            "in": "query",
            "description": "FlavorDB readable alias (example: Salt)",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page index, default 0",
            "required": false,
            "type": "integer"
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size, default 20",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with paginated joined rows"
          },
          "400": {
            "description": "Bad Request: Provide at least one query parameter"
          },
          "404": {
            "description": "No connections found matching the criteria"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/recipe2-api/connections/dropdowns": {
      "get": {
        "tags": [
          "Cross-Database Connections"
        ],
        "summary": "Get Dropdown Values",
        "description": "Returns a unique list of formatted {label, value} options for frontend dropdowns or autocomplete inputs.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Must be 'ingredient' (RecipeDB), 'entity' (FlavorDB by name), or 'entity_id' (FlavorDB by ID).",
            "required": true,
            "type": "string"
          },
          {
            "name": "search",
            "in": "query",
            "description": "Optional search text for autocomplete functionality (e.g., 'garlic').",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return. Default is 50.",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with an array of dropdown options"
          },
          "400": {
            "description": "Bad Request: Invalid type provided"
          }
        }
      }
    }
